{
  "name": "ffmpeg-expo",
  "version": "0.0.1",
  "description": "FFmpeg for Expo/React Native - native video/audio processing without ffmpeg-kit",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf build plugin/build",
    "prepublishOnly": "npm run build && npm run build:plugin",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "expo",
    "react-native",
    "ffmpeg",
    "video",
    "audio",
    "transcoding",
    "compression"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kingjnr4/ffmpeg-expo.git"
  },
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "expo": ">=51.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^56.0.8",
    "@types/react": "^18.3.0",
    "expo": "^56.0.0",
    "expo-module-scripts": "^4.0.0",
    "expo-modules-core": "^2.2.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "build",
    "android",
    "ios",
    "plugin/build",
    "scripts",
    "expo-module.config.json",
    "app.plugin.js"
  ]
}
